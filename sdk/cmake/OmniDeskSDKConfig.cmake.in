@PACKAGE_INIT@

if(NOT TARGET OmniDesk::SDK)
    set(_OMNIDESK_SDK_LIB "@OMNIDESK_SDK_CONFIG_LIB@")
    set(_OMNIDESK_SDK_INCLUDES "@OMNIDESK_SDK_CONFIG_INCLUDES@")

    add_library(OmniDesk::SDK SHARED IMPORTED)
    set_target_properties(OmniDesk::SDK PROPERTIES
        IMPORTED_LOCATION "${_OMNIDESK_SDK_LIB}"
        INTERFACE_INCLUDE_DIRECTORIES "${_OMNIDESK_SDK_INCLUDES}"
        INTERFACE_COMPILE_FEATURES "cxx_std_17"
        INTERFACE_COMPILE_DEFINITIONS "BRLS_RESOURCES=\"@OMNIDESK_BRLS_RESOURCES@\";YG_ENABLE_EVENTS;__SDL2__;BOREALIS_USE_OPENGL;FONS_HASH_LUT_SIZE=4096"
    )
endif()

set(OmniDeskSDK_VERSION "@OMNIDESK_VERSION@")
set(OmniDeskSDK_ABI_VERSION 1)
set(OmniDeskSDK_FOUND TRUE)
