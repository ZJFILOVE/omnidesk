{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnidesk.local/schemas/capability-rpc.schema.json",
  "title": "OmniDesk CapabilityRegistry & EntityBus Standard Payloads",
  "description": "Canonical JSON payload contracts for OmniDesk cross-plugin RPC (CapabilityRegistry) and events (EntityBus).",
  "$defs": {
    "CapabilityResultEnvelope": {
      "type": "object",
      "required": ["ok", "data", "error", "provider_plugin_id"],
      "properties": {
        "ok": { "type": "boolean" },
        "data": { "type": "object" },
        "error": { "type": "string" },
        "provider_plugin_id": { "type": "string" }
      }
    },
    "PublicationEvidence": {
      "type": "object",
      "description": "Committed upstream publication proof. qa_verified alone is never sufficient.",
      "required": [
        "status",
        "publication_verified",
        "operation_id",
        "project",
        "business_date",
        "receipt"
      ],
      "properties": {
        "status": { "type": "string", "enum": ["PUBLISHED"] },
        "publication_verified": { "type": "boolean", "enum": [true] },
        "operation_id": { "type": "string" },
        "project": {
          "type": "string",
          "enum": ["music", "news-youtube-reddit", "english", "journal", "daily"]
        },
        "business_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "receipt": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            {
              "type": "object",
              "minProperties": 1,
              "properties": {
                "id": { "type": "string" },
                "receipt_id": { "type": "string" },
                "path": { "type": "string" },
                "bundle_sha256": { "type": "string" },
                "manifest_blob": { "type": "string" }
              }
            }
          ]
        }
      }
    },
    "LlmRouterRequest": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "current_route",
            "gateway_status",
            "list_harnesses",
            "list_models",
            "list_groups",
            "list_quotas",
            "set_route"
          ]
        },
        "group_id": {
          "type": "string",
          "default": "omnidesk-active",
          "description": "Dedicated Magpie routing group managed by OmniDesk (never modifies terminal harness bindings)."
        },
        "harness_provider": {
          "type": "string",
          "description": "Selected underlying harness/provider namespace (e.g. 'codex', 'antigravity', 'zcode', 'zhipu', 'group')."
        },
        "model_id": {
          "type": "string",
          "description": "Canonical Magpie model or group id (e.g. 'codex/gpt-6-luna', 'antigravity/gemini-4-carbon', 'group/smart-split')."
        },
        "effort": {
          "type": "string",
          "enum": ["", "none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"]
        },
        "account": {
          "type": "string",
          "description": "Optional Magpie account pin appended as #<account>."
        },
        "fast": {
          "type": "boolean",
          "default": false
        },
        "routing": {
          "type": "string",
          "enum": ["manual", "order", "smart", "usage", "pace", "rotate", "drain"],
          "default": "order"
        },
        "stays": {
          "type": "string",
          "enum": ["auto", "turn", "session", "off", "strict"],
          "default": "turn"
        },
        "fallbacks": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    },
    "LlmRouterCurrentRouteData": {
      "type": "object",
      "required": ["summary", "gateway_url", "group_id", "primary_member"],
      "properties": {
        "summary": {
          "type": "string",
          "description": "Compact status string consumed directly by AiCompanionDock (e.g. 'group/omnidesk-active -> antigravity/gemini-4-carbon:high')."
        },
        "gateway_url": { "type": "string" },
        "gateway_running": { "type": "boolean" },
        "group_id": { "type": "string" },
        "harness_provider": { "type": "string" },
        "primary_member": { "type": "string" },
        "routing": { "type": "string" },
        "stays": { "type": "string" },
        "fallbacks": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "AiAgentRequest": {
      "type": "object",
      "required": [],
      "properties": {
        "action": {
          "type": "string",
          "enum": ["chat", "qa", "summarize", "translate", "etymology", "parse_sentence", "clause_parse", "custom"],
          "default": "chat"
        },
        "session_action": {
          "type": "string",
          "enum": ["list", "get", "delete", "rename", "export"],
          "description": "Conversation management action. Omit for a normal chat turn."
        },
        "session_id": {
          "type": "string",
          "description": "Persisted agent session ID. Include it to continue an existing conversation."
        },
        "session_title": { "type": "string" },
        "session_format": {
          "type": "string",
          "enum": ["markdown", "json"],
          "default": "markdown"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 50
        },
        "domain": {
          "type": "string",
          "enum": ["core", "media", "text", "book"],
          "default": "core"
        },
        "context": { "type": "string" },
        "context_title": { "type": "string" },
        "system_prompt": { "type": "string" },
        "prompt": { "type": "string" },
        "selection": { "type": "string" },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["role", "content"],
            "properties": {
              "role": { "type": "string", "enum": ["system", "user", "assistant"] },
              "content": { "type": "string" }
            }
          }
        },
        "route_override": {
          "type": "string",
          "description": "Optional Magpie group or provider/model override for this single call."
        },
        "json_schema": {
          "type": "object",
          "description": "Optional structured JSON output schema."
        },
        "temperature": { "type": "number" },
        "timeout_ms": { "type": "integer", "default": 60000 }
      }
    },
    "AiAgentResponseData": {
      "type": "object",
      "required": [],
      "properties": {
        "reply": { "type": "string" },
        "action": { "type": "string" },
        "domain": { "type": "string" },
        "structured": { "type": ["object", "array", "null"] },
        "served_model": { "type": "string" },
        "model": { "type": "string" },
        "route_group": { "type": "string" },
        "session_id": { "type": "string" },
        "persisted": { "type": "boolean" },
        "user_message_id": { "type": "string" },
        "assistant_message_id": { "type": "string" },
        "session": { "type": "object" },
        "sessions": {
          "type": "array",
          "items": { "type": "object" }
        },
        "count": { "type": "integer" },
        "deleted": { "type": "boolean" },
        "format": { "type": "string", "enum": ["markdown", "json"] },
        "mime_type": { "type": "string" },
        "filename": { "type": "string" },
        "content": { "type": "string" },
        "usage": {
          "type": "object",
          "properties": {
            "prompt_tokens": { "type": "integer" },
            "completion_tokens": { "type": "integer" },
            "total_tokens": { "type": "integer" }
          }
        }
      }
    },
    "NasConnectionRequest": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": {
          "type": "string",
          "enum": ["status", "probe", "list_mounts", "safe_write_subtitle"]
        },
        "target_path": { "type": "string" },
        "content": { "type": "string" },
        "allow_overwrite_own": { "type": "boolean", "default": true }
      }
    },
    "MediaClipJumpRequest": {
      "type": "object",
      "required": ["query"],
      "properties": {
        "query": {
          "type": "string",
          "description": "Word, idiom, or dialogue phrase to search across indexed NAS subtitle corpus."
        },
        "series_filter": { "type": "string" },
        "limit": { "type": "integer", "default": 10 },
        "auto_open_player": { "type": "boolean", "default": false }
      }
    },
    "EntityMediaOpenEvent": {
      "type": "object",
      "required": ["item_id", "play_url"],
      "properties": {
        "item_id": { "type": "string" },
        "source_id": { "type": "string" },
        "title": { "type": "string" },
        "kind": { "type": "string", "enum": ["video", "music", "live", "nas"] },
        "play_url": { "type": "string" },
        "start_sec": { "type": "number", "default": 0 },
        "end_sec": { "type": "number" },
        "subtitle_path": { "type": "string" }
      }
    },
    "SpeechAsrCue": {
      "type": "object",
      "required": ["index", "start_ms", "end_ms", "text"],
      "properties": {
        "index": { "type": "integer", "minimum": 1 },
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 0 },
        "start_sec": { "type": "number", "minimum": 0 },
        "end_sec": { "type": "number", "minimum": 0 },
        "text": { "type": "string" }
      }
    },
    "SpeechAsrRequest": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "status",
            "probe",
            "list_streams",
            "transcribe_audio",
            "transcribe_media",
            "cancel",
            "clear_cache"
          ]
        },
        "probe_runtime": { "type": "boolean", "default": false },
        "audio_path": { "type": "string" },
        "pcm_s16le_base64": { "type": "string" },
        "sample_rate": { "type": "integer", "minimum": 8000, "maximum": 192000, "default": 16000 },
        "channels": { "type": "integer", "minimum": 1, "maximum": 8, "default": 1 },
        "normalize": { "type": "boolean", "default": false },
        "media_path": { "type": "string" },
        "output_srt_path": { "type": "string" },
        "audio_stream": { "type": "integer", "default": 0 },
        "chunk_seconds": { "type": "integer", "minimum": 15, "maximum": 1800, "default": 120 },
        "vad_maxseg_ms": { "type": "integer", "minimum": 500, "maximum": 60000, "default": 10000 },
        "use_vad": { "type": "boolean", "default": true },
        "keep_tags": { "type": "boolean", "default": false },
        "backend": { "type": "string", "enum": ["vulkan", "cpu", "auto"], "default": "vulkan" },
        "auto_fallback_cpu": { "type": "boolean", "default": true },
        "reset_cache": { "type": "boolean", "default": false },
        "offset_ms": { "type": "integer", "default": 0 },
        "timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 3600000, "default": 180000 },
        "job_id": { "type": "string" }
      }
    },
    "EntityAsrProgressEvent": {
      "type": "object",
      "required": ["job_id", "media_path", "completed_chunks", "total_chunks", "progress"],
      "properties": {
        "job_id": { "type": "string" },
        "media_path": { "type": "string" },
        "completed_chunks": { "type": "integer", "minimum": 0 },
        "total_chunks": { "type": "integer", "minimum": 1 },
        "progress": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "FeedRecipeRequest": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "list_recipes",
            "get_recipe",
            "save_recipe",
            "delete_recipe",
            "reload",
            "test_recipe",
            "fetch_feed",
            "translate_article"
          ]
        },
        "id": { "type": "string" },
        "recipe_id": { "type": "string" },
        "article_id": { "type": "string" },
        "query": { "type": "string" },
        "format": { "type": "string", "enum": ["json", "lua"] },
        "content": { "type": "string" },
        "target_lang": { "type": "string", "default": "zh-CN" },
        "force": { "type": "boolean", "default": true }
      }
    },
    "WebCookiesRequest": {
      "type": "object",
      "required": ["action", "url"],
      "properties": {
        "action": { "type": "string", "enum": ["get_cookies"] },
        "url": { "type": "string" },
        "domain": { "type": "string" },
        "include_subdomains": { "type": "boolean", "default": true }
      }
    },
    "SubtitleFetchRequest": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": {
          "type": "string",
          "enum": ["status", "probe", "derive_query", "search", "download"]
        },
        "provider": { "type": "string", "enum": ["all", "subhd", "assrt"], "default": "all" },
        "query": { "type": "string" },
        "filename": { "type": "string" },
        "path": { "type": "string" },
        "title": { "type": "string" },
        "season": { "type": "integer" },
        "episode": { "type": "integer" },
        "id": { "type": "string" },
        "output_dir": { "type": "string" }
      }
    },
    "SubtitleSyncRequest": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": {
          "type": "string",
          "enum": ["status", "probe", "shift", "sync"]
        },
        "subtitle_path": { "type": "string" },
        "reference_path": { "type": "string" },
        "output_path": { "type": "string" },
        "mode": { "type": "string", "enum": ["auto", "ffsubsync", "manual_shift"], "default": "auto" },
        "split": { "type": "boolean", "default": false },
        "audio_stream": { "type": "integer", "default": -1 },
        "max_offset_seconds": { "type": "number", "default": 60.0 },
        "offset_ms": { "type": "number", "default": 0 },
        "scale": { "type": "number", "default": 1.0 }
      }
    },
    "RecommendFeedRequest": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "bootstrap_and_rehydrate",
            "list_archive_dates",
            "search_archive",
            "publish_daily_bundle",
            "push_interactive_set",
            "list_sets",
            "get_set",
            "pin_item",
            "dismiss_item",
            "clear_interactive",
            "status"
          ]
        },
        "mode": {
          "type": "string",
          "enum": ["daily_immutable", "interactive_ephemeral"]
        },
        "pull_remote": { "type": "boolean", "default": true },
        "operation_id": { "type": "string" },
        "business_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "qa_verified": { "type": "boolean", "default": false },
        "publication_evidence": { "$ref": "#/$defs/PublicationEvidence" },
        "session_id": { "type": "string" },
        "title": { "type": "string" },
        "user_prompt": { "type": "string" },
        "repeat_policy": {
          "type": "string",
          "enum": ["allow_any", "prefer_familiar", "session_dedup_only"],
          "default": "allow_any"
        },
        "record_permanent_history": {
          "type": "boolean",
          "description": "Must be false whenever mode == 'interactive_ephemeral'."
        },
        "replace_session_items": { "type": "boolean", "default": false },
        "auto_focus": { "type": "boolean", "default": false },
        "ephemeral_chat_note": {
          "type": "string",
          "description": "Transient UI/chat-only note (e.g. English daily diet reminder); never persisted to disk or git."
        },
        "query": { "type": "string" },
        "media_items": { "type": "array", "items": { "type": "object" } },
        "text_items": { "type": "array", "items": { "type": "object" } },
        "book_items": { "type": "array", "items": { "type": "object" } },
        "vocab_cards": { "type": "array", "items": { "type": "object" } }
      }
    },
    "MediaPlaylistRequest": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "status",
            "list_playlists",
            "preflight_cn_catalog",
            "sync_daily_authorized",
            "write_interactive_playlist",
            "enqueue_playback"
          ]
        },
        "mode": {
          "type": "string",
          "enum": ["daily_immutable", "interactive_ephemeral"]
        },
        "storefront": { "type": "string", "default": "cn" },
        "business_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "operation_id": { "type": "string" },
        "qa_verified": { "type": "boolean", "default": false },
        "dry_run": { "type": "boolean", "default": false },
        "local_checkpoint_only": { "type": "boolean", "default": false },
        "sync_all_rehydrated": { "type": "boolean", "default": false },
        "cumulative_playlist_id": {
          "type": "string",
          "default": "p.YJXV7dEIeb3GzZX",
          "description": "Protected ChatGPT Daily 5 cumulative playlist; strictly forbidden in interactive_ephemeral mode."
        },
        "create_dated_playlist": { "type": "boolean", "default": true },
        "dated_playlist_prefix": { "type": "string", "default": "ChatGPT Daily 5 · " },
        "playlist_id": { "type": "string" },
        "playlist_name": { "type": "string" },
        "write_strategy": {
          "type": "string",
          "enum": ["append", "replace_ephemeral"],
          "default": "append"
        },
        "enqueue_now": { "type": "boolean", "default": false },
        "record_permanent_history": { "type": "boolean", "default": false },
        "track_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[0-9]+$" }
        }
      }
    },
    "AiCurationRequest": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": {
          "type": "string",
          "enum": ["curate_interactive", "run_daily_pipeline", "status"]
        },
        "project": {
          "type": "string",
          "enum": ["news-youtube-reddit", "music", "english", "journal"]
        },
        "business_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "qa_verified": { "type": "boolean", "default": false },
        "publication_evidence": { "$ref": "#/$defs/PublicationEvidence" },
        "ephemeral_chat_note": {
          "type": "string",
          "description": "Chat-only note; must never be persisted or written to repositories."
        },
        "prompt": { "type": "string" },
        "domains": {
          "type": "array",
          "items": { "type": "string", "enum": ["media", "text", "book"] }
        },
        "repeat_policy": {
          "type": "string",
          "enum": ["allow_any", "prefer_familiar", "session_dedup_only"],
          "default": "allow_any"
        },
        "sync_apple_music": {
          "type": "string",
          "enum": ["none", "queue", "ephemeral_playlist", "daily_authorized"],
          "default": "none"
        },
        "playlist_name": { "type": "string" },
        "sync_playlist": { "type": "boolean", "default": true },
        "enqueue_now": { "type": "boolean", "default": false },
        "session_id": { "type": "string" },
        "media_items": { "type": "array", "items": { "type": "object" } },
        "text_items": { "type": "array", "items": { "type": "object" } },
        "book_items": { "type": "array", "items": { "type": "object" } },
        "vocab_cards": { "type": "array", "items": { "type": "object" } },
        "active_entity": { "type": "object" }
      }
    },
    "EntityRecommendUpdatedEvent": {
      "type": "object",
      "required": ["mode", "domains", "written_count"],
      "properties": {
        "mode": { "type": "string", "enum": ["daily_immutable", "interactive_ephemeral"] },
        "set_id": { "type": "string" },
        "operation_id": { "type": "string" },
        "domains": { "type": "array", "items": { "type": "string" } },
        "written_count": { "type": "integer", "minimum": 0 },
        "auto_focus": { "type": "boolean", "default": false }
      }
    },
    "EntityMusicPlaylistSyncedEvent": {
      "type": "object",
      "required": ["mode", "playlist_id", "added_count", "verified_count"],
      "properties": {
        "mode": { "type": "string", "enum": ["daily_immutable", "interactive_ephemeral"] },
        "playlist_id": { "type": "string" },
        "playlist_name": { "type": "string" },
        "added_count": { "type": "integer", "minimum": 0 },
        "verified_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
