{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnidesk.local/schemas/plugin-manifest.schema.json",
  "title": "OmniDesk Plugin Manifest (plugin.json)",
  "description": "Schema v2 for OmniDesk zero-ABI Python plugins (schema_version = 2).",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "kind",
    "domain"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2,
      "description": "Manifest schema version for Protocol v2 Python plugins. Must be 2."
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "Globally unique plugin identifier (e.g. 'plugin-magpie-agent', 'plugin-fnos-nas'). Must not contain '/', '\\\\', or '..'."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable display name shown in the Plugin Store and settings."
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$",
      "description": "Semantic version string (e.g. '0.2.0')."
    },
    "runtime": {
      "type": "string",
      "enum": ["python"],
      "default": "python",
      "description": "Plugin execution runtime ('python')."
    },
    "entry": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.]*:[A-Za-z_][A-Za-z0-9_]*$",
      "default": "plugin:create_plugin",
      "description": "Python module:callable entrypoint relative to the plugin directory."
    },
    "kind": {
      "type": "string",
      "enum": ["provider", "workspace", "hybrid", "extension"],
      "description": "Plugin architectural role."
    },
    "domain": {
      "type": "string",
      "enum": ["core", "media", "text", "book"],
      "description": "Primary workbench domain affiliation."
    },
    "author": {
      "type": "string",
      "default": ""
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "repository": {
      "type": "object",
      "required": ["url"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["git"],
          "default": "git"
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "description": "Optional external Git repository URL."
        },
        "branch": {
          "type": "string",
          "default": "main"
        }
      }
    },
    "python_dependencies": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "Optional extra PEP 508 Python dependency specifiers managed via uv."
    },
    "verify_cmd": {
      "type": "string",
      "default": "uv run pytest -q",
      "description": "Offline smoke test command executed before plugin activation."
    },
    "provides": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+\\.v[0-9]+$"
      },
      "default": [],
      "description": "Versioned capability IDs registered by this plugin (e.g. 'llm.router.v1')."
    },
    "consumes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+\\.v[0-9]+$"
      },
      "default": [],
      "description": "Optional versioned capability IDs consumed by this plugin (must gracefully degrade if absent)."
    },
    "permissions": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "Declarative permission badges audited in the Plugin Store UI."
    },
    "config_schema": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["key", "label", "type"],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": ["string", "secret", "bool", "int", "select"]
          },
          "default": {
            "type": ["string", "boolean", "number"]
          },
          "description": {
            "type": "string"
          },
          "required": {
            "type": "boolean",
            "default": false
          },
          "options": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Required and non-empty when type == 'select'."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "type": { "const": "select" } }
            },
            "then": {
              "required": ["options"],
              "properties": {
                "options": { "minItems": 1 }
              }
            }
          }
        ]
      }
    }
  }
}
