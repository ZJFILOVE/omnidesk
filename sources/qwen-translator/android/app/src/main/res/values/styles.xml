<resources>
    <style name="Theme.Feiniu" parent="Theme.Feiniu.Light" />

    <style name="Theme.Feiniu.Light" parent="Base.Theme.Feiniu.Light" />
    <style name="Theme.Feiniu.Dark" parent="Base.Theme.Feiniu.Dark" />

    <style name="Base.Theme.Feiniu.Light" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/app_light_base</item>
        <item name="android:statusBarColor">@color/app_light_base</item>
        <!-- Before API 27, XML cannot request dark navigation icons during launch. -->
        <item name="android:navigationBarColor">#17201C</item>
        <item name="android:colorAccent">@color/app_light_primary</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Base.Theme.Feiniu.Dark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/app_dark_base</item>
        <item name="android:statusBarColor">@color/app_dark_base</item>
        <item name="android:navigationBarColor">@color/app_dark_base</item>
        <item name="android:colorAccent">@color/app_dark_primary</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
