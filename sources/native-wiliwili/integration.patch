+size_t SubtitleCore::pickBestSubtitleIndex() const {
+    if (videoPageData.subtitles.empty()) return 0;
+    size_t bestIdx = 0;
+    int bestScore = 1000;
+    for (size_t i = 0; i < videoPageData.subtitles.size(); ++i) {
+        const auto& sub = videoPageData.subtitles[i];
+        if (sub.subtitle_url.empty() && sub.data.body.empty()) continue;
+        int score = trackPriority(sub);
+        if (score < bestScore) {
+            bestScore = score;
+            bestIdx = i;
+        }
+    }
+    return bestIdx;
+}
