+void SubtitleCore::normalizeSubtitleData(bilibili::VideoPageSubtitle& page) const {
+    auto& body = page.data.body;
+    if (body.empty()) return;
+    bool allInt = true;
+    float maxVal = 0.0f;
+    for (const auto& item : body) {
+        if (!std::isfinite(item.from) || !std::isfinite(item.to) ||
+            std::floor(item.from) != item.from || std::floor(item.to) != item.to) {
+            allInt = false;
+        }
+        maxVal = std::max(maxVal, std::max(item.from, item.to));
+    }
+    double duration = MPVCore::instance().duration;
+    double ceiling = std::max(duration > 0 ? duration * 1.2 : 0.0, 3600.0);
+    float scale = (allInt && maxVal > ceiling) ? 0.001f : 1.0f;
+    bilibili::SubtitleBody cleaned;
+    cleaned.reserve(body.size());
+    for (auto item : body) {
+        item.from = std::max(0.0f, item.from * scale);
+        item.to = item.to * scale;
+        item.content = trimSubtitleText(item.content);
+        item.length = -1;
+        if (item.content.empty() || item.to <= item.from) continue;
+        cleaned.push_back(std::move(item));
+    }
+    std::sort(cleaned.begin(), cleaned.end(), [](const bilibili::SubtitleLine& lhs, const bilibili::SubtitleLine& rhs) {
+        return lhs.from == rhs.from ? lhs.to < rhs.to : lhs.from < rhs.from;
+    });
+    bilibili::SubtitleBody deduped;
+    deduped.reserve(cleaned.size());
+    for (auto& item : cleaned) {
+        if (!deduped.empty() && deduped.back().content == item.content && item.from - deduped.back().to <= 1.0f) {
+            deduped.back().to = std::max(deduped.back().to, item.to);
+        } else {
+            deduped.push_back(std::move(item));
+        }
+    }
+    body = std::move(deduped);
+    if (page.isAI || toLowerCopy(page.lan).rfind("ai-", 0) == 0) page.data.genByAI = true;
+}
 
