+namespace {
+void getNativeVideoUrl(const std::string& idKey, const std::string& id, uint64_t cid, int preference,
+                       const std::function<void(VideoUrlResult)>& callback, const ErrorCallback& error,
+                       std::shared_ptr<std::atomic<bool>> cancellation) {
+    const auto epoch = wiliwili::auth::generation();
+    const auto expectedMid = ProgramConfig::instance().getUserID();
+    const auto codec = BilibiliClient::VIDEO_CODEC;
+    const auto audioPreference = BilibiliClient::AUDIO_QUALITY;
+    const auto proxy = ProgramConfig::instance().getProxy();
+    const char* overridePath = std::getenv("WILI_ANDROID_SESSION");
+    const std::string sessionPath = overridePath ? overridePath : ProgramConfig::instance().getConfigDir() + "/android-session.json";
+    const auto cancel = [cancellation, epoch] { return (cancellation && cancellation->load()) || epoch != wiliwili::auth::generation(); };
+    const bool unlock = BilibiliClient::UNLOCK_QUALITY;
+    const cpr::Parameters params = {
+        {idKey, id}, {"cid", std::to_string(cid)},
+        {"gaia_source", "view-card"}, {"from_client", "BROWSER"},
+        {"is_main_page", "false"}, {"need_fragment", "false"}, {"isGaiaAvoided", "true"},
+        {"voice_balance", "1"}, {"web_location", "1315873"},
+        {"qn", std::to_string(wiliwili::quality::requestQuality(preference))},
+        {"fourk", "1"}, {"fnval", wiliwili::quality::requestFeatures(BilibiliClient::FNVAL)}, {"fnver", "0"}};
+    HTTP::getResultWithWbiAsync<VideoUrlResult>(Api::PlayUrl2, params,
+        [idKey, id, cid, preference, unlock, callback, cancel, expectedMid, codec, audioPreference, proxy, sessionPath](VideoUrlResult original) {
+            if (cancel()) { if (callback) callback(original); return; }
+            if (unlock && BilibiliClient::FNVAL != "0" &&
+                wiliwili::quality::availableQuality(original) < wiliwili::quality::requestQuality(preference)) {
+                VideoUrlResult candidate{};
+                const auto* preferredAudio = wiliwili::quality::selectAudio(original.dash, audioPreference);
+                const auto fallback = std::make_shared<VideoUrlResult>(original);
+                if (wiliwili::android::getPlayUrl(idKey, id, cid,
+                        wiliwili::quality::requestQuality(preference), codec,
+                        sessionPath, proxy, candidate, cancel, expectedMid) &&
+                    (!preferredAudio || preferredAudio->id < 30250 ||
+                     (wiliwili::quality::selectAudio(candidate.dash, audioPreference) &&
+                      wiliwili::quality::selectAudio(candidate.dash, audioPreference)->id == preferredAudio->id)) &&
+                    wiliwili::quality::useAndroidStream(original, candidate)) {
+                    original.ordinaryFallback = fallback;
+                    if (cancel()) { if (callback) callback(original); return; }
+                    brls::Logger::info("Android trial stream: quality={}, duration_ms={}",
+                                       wiliwili::quality::availableQuality(candidate), candidate.timelength);
+                    if (callback) callback(original);
+                    return;
+                }
+            }
+            if (cancel()) { if (callback) callback(original); return; }
+            if (!unlock || !wiliwili::quality::needsCompatibilityStream(original, preference)) {
+                if (callback) callback(original);
+                return;
+            }
+            // The mobile HTML5 endpoint can expose a full 720P/1080P MP4 when
+            // the same account's DASH response stops at 480P. Try once; an
+            // unavailable or shorter stream must never replace working media.
+            HTTP::getResultWithWbiAsync<VideoUrlResult>(Api::PlayUrl2,
+                {{idKey, id}, {"cid", std::to_string(cid)}, {"platform", "html5"}, {"high_quality", "1"},
+                 {"qn", std::to_string(std::min(80, wiliwili::quality::requestQuality(preference)))},
+                 {"fnval", "1"}, {"fnver", "0"}, {"fourk", "1"}},
+                [original, preference, callback, cancel](const VideoUrlResult& candidate) mutable {
+                    if (cancel()) { if (callback) callback(original); return; }
+                    wiliwili::quality::useCompatibilityStream(original, candidate, preference);
+                    if (callback) callback(original);
+                },
+                [original, callback, cancel](const std::string&, int) { if (callback) callback(original); });
+        }, [error, cancel](const std::string& message, int code) { if (error) error(message, code); });
+}
