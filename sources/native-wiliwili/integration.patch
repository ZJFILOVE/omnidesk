+static std::string trimSubtitleText(const std::string& raw) {
+    std::string out;
+    out.reserve(raw.size());
+    bool prevSpace = true;
+    for (unsigned char ch : raw) {
+        if (ch == '\r' || ch == '\n' || ch == '\t' || ch == ' ') {
+            if (!prevSpace) {
+                out.push_back(' ');
+                prevSpace = true;
+            }
+        } else {
+            out.push_back((char)ch);
+            prevSpace = false;
+        }
+    }
+    while (!out.empty() && out.back() == ' ') out.pop_back();
+    return out;
+}
