+int SubtitleCore::trackPriority(const bilibili::VideoPageSubtitle& sub) {
+    std::string lan = toLowerCopy(sub.lan);
+    bool ai = sub.isAI || sub.data.genByAI || lan.rfind("ai-", 0) == 0 ||
+              sub.lan_doc.find("自动生成") != std::string::npos;
+    bool isZh = lan.rfind("zh", 0) == 0 || lan.rfind("ai-zh", 0) == 0;
+    int base = isZh ? (ai ? 10 : 0) : (ai ? 30 : 20);
+    if (lan == "zh-cn" || lan == "zh-hans" || lan == "ai-zh" || lan == "ai-zh-cn") return base;
+    if (lan == "zh") return base + 1;
+    if (isZh) return base + 2;
+    return base + 3;
+}
