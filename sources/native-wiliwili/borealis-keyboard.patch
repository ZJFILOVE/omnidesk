+float Label::getRenderedFontSize() const
+{
+    const float scale = std::max(.01f, Application::windowScale);
+    // Keep the established tiled-window density; give wide desktop windows
+    // a modest reading-size increase instead of freezing every glyph at 12px.
+    const float readingScale = std::clamp(Application::windowWidth / 1600.f, 1.f, 1.25f);
+    const float pixels = fontSize * FONT_SCALE * readingScale * std::min(1.f, scale / .75f);
+    return std::max(1.f, std::round(pixels)) / scale;
